# Rijksmuseum — currently unavailable. The classic keyed API is deprecated and
# key issuance has been retired from Rijksstudio settings; the keyless
# replacement returns only Linked-Art IRIs (no direct images). The adapter
# self-disables without a key; the app runs on AIC, CMA, the Met, SMK and Mia. Leave blank.
RIJKSMUSEUM_API_KEY=

# Harvard Art Museums — free key, issued by the form at
# https://harvardartmuseums.org/collections/api (pick "API Token", arrives by
# email). The adapter self-disables without one; set it and add "harvard" to
# ALL_SOURCES in src/app/page.tsx to light it up. 2,500 requests/day.
HARVARD_API_KEY=

# LLM for Curio (the agent) and the "describe" route.
#   • claude — local `npm run dev`: a Claude Code session on your `claude
#     login`. No env needed if you're logged in.
#   • gateway — Vercel AI Gateway. This is the hosted default and uses Vercel
#     OIDC in deployments. For local Gateway testing, create an API key and set
#     AI_GATEWAY_API_KEY.
# Force one with CURIO_LLM_ENGINE=claude|gateway.
# Search, categories, calm scoring, collections, export and the recorded
# homepage examples need no LLM.
AI_GATEWAY_API_KEY=
# CURIO_LOCAL_MODEL=sonnet            # local Curio (Claude alias)
# CURIO_LOCAL_INTERPRET_MODEL=haiku   # local describe
# CURIO_ROUTER=jev                    # route with Jev via the Gateway (experimental; off)

# Optional overrides. Model vars take a comma-separated list: the first is
# primary, the rest are fallbacks. Defaults (in code, src/lib/ai/models.ts,
# chosen by `npm run bench:models`, 2026-09-24):
#   curator    anthropic/claude-haiku-4.5,google/gemini-3.1-flash-lite
#              Haiku got every bench turn right with the best comments, 20-35s
#              and ~$0.03 a curate turn; Flash-Lite is the cheap fallback.
#   interpret  google/gemini-2.5-flash-lite,google/gemini-3.1-flash-lite
# Avoid for the curator: gemini-2.5-flash-lite (asks the visitor questions
# instead of curating), sonnet-class models (too slow for Vercel's 60s), and
# `:free` models (rate-limited upstream on a shared pool; 20 requests a
# minute and 50-1,000 a day per account, and a Curio turn is 6-8 requests).
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=              # key for a non-OpenRouter endpoint (takes precedence)
# CURIO_CURATOR_MODEL=anthropic/claude-haiku-4.5,google/gemini-3.1-flash-lite
# CURIO_INTERPRET_MODEL=google/gemini-2.5-flash-lite
